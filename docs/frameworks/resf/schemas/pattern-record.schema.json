{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RESF Pattern Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "module",
    "lifecycle",
    "qualification",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PAT-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "pattern": "^RESF-"
    },
    "lifecycle": {
      "const": "CANDIDATE"
    },
    "qualification": {
      "enum": [
        "PROVEN",
        "PROMISING",
        "PAGE_SPECIFIC",
        "SUPERSEDED",
        "CONTRADICTED",
        "UNVALIDATED"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
